{
  "name": "dsh-memory-yearring",
  "version": "0.4.5",
  "private": false,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./lib/*": "./lib/*"
  },
  "files": [
    "index.js",
    "lib",
    "tools",
    "starmap-ui",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "CONTRACT-v1.md",
    "VERSION",
    "icon.svg",
    "client.js"
  ],
  "description": "年轮（建木·认知层）：从根藏原话里提炼带原话锚点的 claim，并拼成 topic 正文；不改原文、不注入、默认零 LLM 自动调用",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "cognition",
    "claim",
    "yearring",
    "jianmu"
  ],
  "license": "MIT",
  "author": "zhaohualiuyuejun",
  "icon": "icon.svg",
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5 || >=0.2.2-rc.1"
  },
  "scripts": {
    "selftest": "node tools/selftest.mjs",
    "acceptance": "node tools/acceptance.mjs",
    "status": "node tools/cli.mjs status",
    "checkStore": "node tools/check-external-store.mjs",
    "smoke:external": "node tools/external-store-smoke.mjs",
    "backfill:speaker": "node tools/backfill-claim-speaker.mjs",
    "compact:claims": "node tools/compact-claims.mjs",
    "starmap:build": "node tools/starmap-build.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
